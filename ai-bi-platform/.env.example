# ---- database ----
DATABASE_URL=postgresql+psycopg2://bi_user:bi_pass@db:5432/bi_warehouse
# read-only connection used ONLY by the AI chatbot (defence in depth)
READONLY_DATABASE_URL=postgresql+psycopg2://bi_readonly:readonly_pass@db:5432/bi_warehouse

# ---- auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# ---- AI (Groq) ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

MAX_UPLOAD_MB=25
